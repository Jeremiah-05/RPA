# ==============================================================================
# Expense Claim RPA Verification System - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=expense_rpa_db

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_expense_rpa_2026_secure_key
JWT_EXPIRES_IN=24h

# RPA Handoff File Paths (relative to backend root or absolute)
RPA_INPUT_PATH=../rpa/input/claims_input.xlsx
RPA_OUTPUT_PATH=../rpa/output/claims_verified.xlsx

# File Upload Settings
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads/receipts

# RPA File Watcher (auto-imports verified claims when UiPath writes output file)
ENABLE_RPA_FILE_WATCHER=true
